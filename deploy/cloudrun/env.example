# Settings for deploy\cloudrun\deploy.ps1.
# Copy this file to deploy\cloudrun\.env.cloudrun (that name is git-ignored) and fill in the values.
# Never commit the filled-in copy: it holds your database password and API key.

# The Google Cloud project ID (not its display name). Use a NEW project made for this demo, so nothing
# else you own is touched. Find it at https://console.cloud.google.com (project picker).
PROJECT_ID=your-project-id

# us-east1 is close to Neon's "US East (N. Virginia)" and is one of Cloud Run's lowest-price regions.
REGION=us-east1
SERVICE=green-computer

# Neon: Dashboard > your project > Connect. Turn "Connection pooling" OFF and copy the string that
# starts with postgresql://. The script changes the start and adds sslmode for you.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Nebius Token Factory key (same one as in your local .env). Leave empty to run the demo without the AI.
TOKEN_FACTORY_API_KEY=

# Tavily key (same one as in your local .env). Turns on datasheet search in the demo, limited to
# GC_DATASHEET_RATE_PER_HOUR imports per visitor address (default 5). Leave empty to keep it off.
TAVILY_API_KEY=

# Optional. Leave empty and the script generates and stores random values the first time. Set them only
# if you move the demo to another host and want sessions and agent signatures to stay valid.
GC_SECRET_KEY=
GC_AGENT_SIGNING_SECRET=

# Optional model overrides (same meaning as in .env.example). Empty = matched from the provider's list.
GC_MODEL_ULTRA=
GC_MODEL_SUPER=
GC_MODEL_NANO=
